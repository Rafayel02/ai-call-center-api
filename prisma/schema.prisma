generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum SttProvider {
  ELEVENLABS
  HISPEECH
}

enum TtsProvider {
  ELEVENLABS
}

enum LlmProvider {
  OPENAI
}

enum SttCheckStatus {
  SUCCEEDED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  speechModels       SpeechToTextModel[]
  textToSpeechModels TextToSpeechModel[]
  llmModels          LlmModel[]
  datasetSamples DatasetSample[]
  organizations  Organization[]
  scenarios      Scenario[]

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  nameKey     String   @unique @map("name_key")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String     @map("created_by") @db.Uuid
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  scenarios   Scenario[]

  @@index([createdById])
  @@map("organizations")
}

model Scenario {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  icon           String
  graph          Json
  active         Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdById    String       @map("created_by") @db.Uuid
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([createdById])
  @@map("scenarios")
}

model SpeechToTextModel {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  provider    SttProvider
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String      @map("created_by") @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  checks      SpeechToTextResult[]

  @@index([provider])
  @@index([createdById])
  @@map("speech_to_text_models")
}

model TextToSpeechModel {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  provider    TtsProvider
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String      @map("created_by") @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  clips       TextToSpeechClip[]

  @@index([provider])
  @@index([createdById])
  @@map("text_to_speech_models")
}

model LlmModel {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  provider    LlmProvider
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String      @map("created_by") @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([provider])
  @@index([createdById])
  @@map("llm_models")
}

model TextToSpeechClip {
  id              String            @id @default(uuid()) @db.Uuid
  modelId         String            @map("model_id") @db.Uuid
  model           TextToSpeechModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  cacheKey        String            @unique @map("cache_key")
  providerModelId String            @map("provider_model_id")
  voiceId         String            @map("voice_id")
  text            String
  audio           Bytes
  mimeType        String            @map("mime_type")
  byteSize        Int               @map("byte_size")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([modelId])
  @@map("text_to_speech_clips")
}

model DatasetSample {
  id          String   @id @default(uuid()) @db.Uuid
  sentence    String
  age         String?
  gender      String?
  locale      String?
  audio       Bytes
  audioSha256 String   @map("audio_sha256")
  mimeType    String   @map("mime_type")
  filename    String
  byteSize    Int      @map("byte_size")
  source      String?
  externalId  String?  @unique @map("external_id")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  speechToTextResults SpeechToTextResult[]

  @@index([createdById])
  @@index([source])
  @@index([audioSha256])
  @@map("dataset_samples")
}

model SpeechToTextResult {
  id            String             @id @default(uuid()) @db.Uuid
  engineKey     String             @map("engine_key")
  sampleId      String             @map("sample_id") @db.Uuid
  sample        DatasetSample      @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  status        SttCheckStatus
  transcript    String?
  languageCode  String?            @map("language_code")
  error         String?
  modelId       String?            @map("model_id") @db.Uuid
  model         SpeechToTextModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  attempts      Int                @default(1)
  createdAt     DateTime           @default(now()) @map("created_at")
  lastAttemptAt DateTime           @default(now()) @map("last_attempt_at")

  @@unique([engineKey, sampleId])
  @@index([sampleId])
  @@index([modelId, lastAttemptAt])
  @@map("speech_to_text_results")
}
