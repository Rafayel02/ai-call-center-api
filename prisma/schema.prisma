generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum SttProvider {
  ELEVENLABS
  HISPEECH
}

enum TtsProvider {
  ELEVENLABS
}

enum LlmProvider {
  OPENAI
}

enum PhoneStreamProvider {
  TWILIO
}

enum SttCheckStatus {
  SUCCEEDED
  FAILED
}

enum ExecutionStatus {
  RUNNING
  FINISHED
  STOPPED
  FAILED
}

enum ExecutionSource {
  PLAY
  PHONE
}

enum ExecutionAudioKind {
  CALLER
  MIX
  UTTERANCE
  TTS
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  speechModels       SpeechToTextModel[]
  textToSpeechModels TextToSpeechModel[]
  llmModels          LlmModel[]
  datasetSamples DatasetSample[]
  organizations  Organization[]
  scenarios      Scenario[]
  scenarioExecutions ScenarioExecution[]
  phoneStreamingServices PhoneStreamingService[]

  @@map("users")
}

/// A Twilio account an admin connects. The auth token is encrypted inside config.
model PhoneStreamingService {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  provider    PhoneStreamProvider
  config      Json
  enabled     Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  createdById String              @map("created_by") @db.Uuid
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  numbers     PhoneNumber[]

  @@index([provider])
  @@index([createdById])
  @@map("phone_streaming_services")
}

/// One inbound call Twilio posted to the voice webhook.
model PhoneCall {
  id          String    @id @default(uuid()) @db.Uuid
  callSid     String    @unique @map("call_sid")
  fromNumber  String?   @map("from_number")
  toNumber    String    @map("to_number")
  scenarioId  String?   @map("scenario_id") @db.Uuid
  scenario    Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  receivedAt  DateTime  @default(now()) @map("received_at")

  @@index([receivedAt])
  @@index([scenarioId])
  @@map("phone_calls")
}

/// A number on a streaming account. It can be chosen by one scenario.
model PhoneNumber {
  id                 String                 @id @default(uuid()) @db.Uuid
  e164               String                 @unique
  streamingServiceId String                 @map("streaming_service_id") @db.Uuid
  streamingService   PhoneStreamingService  @relation(fields: [streamingServiceId], references: [id], onDelete: Restrict)
  scenarioId         String?                @unique @map("scenario_id") @db.Uuid
  scenario           Scenario?              @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@index([streamingServiceId])
  @@map("phone_numbers")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  nameKey     String   @unique @map("name_key")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String     @map("created_by") @db.Uuid
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  scenarios   Scenario[]

  @@index([createdById])
  @@map("organizations")
}

model Scenario {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  icon           String
  graph          Json
  active         Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdById    String       @map("created_by") @db.Uuid
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  executions     ScenarioExecution[]
  phoneNumber    PhoneNumber?
  phoneCalls     PhoneCall[]

  @@index([organizationId])
  @@index([createdById])
  @@map("scenarios")
}

model ScenarioExecution {
  id             String          @id @db.Uuid
  scenarioId     String          @map("scenario_id") @db.Uuid
  scenario       Scenario        @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  startedById    String          @map("started_by") @db.Uuid
  startedBy      User            @relation(fields: [startedById], references: [id], onDelete: Restrict)
  status         ExecutionStatus @default(RUNNING)
  source         ExecutionSource @default(PLAY)
  startedAt      DateTime        @default(now()) @map("started_at")
  endedAt        DateTime?       @map("ended_at")
  lastActivityAt DateTime        @default(now()) @map("last_activity_at")
  durationMs     Int?            @map("duration_ms")
  inquiry        String?
  topicId        String?         @map("topic_id")
  topicLabel     String?         @map("topic_label")
  errorMessage   String?         @map("error_message")
  priceUsd       Decimal?        @map("price_usd") @db.Decimal(12, 6)
  priceComplete  Boolean         @default(false) @map("price_complete")
  priceParts     Json?           @map("price_parts")
  graph          Json
  peaks          Json?
  callerMime     String?         @map("caller_mime")
  mixMime        String?         @map("mix_mime")
  audio          ScenarioExecutionAudio[]
  events         ScenarioExecutionEvent[]

  @@index([scenarioId, startedAt])
  @@index([startedById])
  @@map("scenario_executions")
}

model ScenarioExecutionAudio {
  id          String                 @id @default(uuid()) @db.Uuid
  executionId String                 @map("execution_id") @db.Uuid
  execution   ScenarioExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  kind        ExecutionAudioKind
  mimeType    String                 @map("mime_type")
  audio       Bytes
  byteSize    Int                    @map("byte_size")
  events      ScenarioExecutionEvent[]

  @@index([executionId])
  @@map("scenario_execution_audio")
}

model ScenarioExecutionEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  executionId String                  @map("execution_id") @db.Uuid
  execution   ScenarioExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  clientSeq   Int                     @map("client_seq")
  offsetMs    Int                     @map("offset_ms")
  type        String
  nodeId      String?                 @map("node_id")
  payload     Json
  audioId     String?                 @map("audio_id") @db.Uuid
  audio       ScenarioExecutionAudio? @relation(fields: [audioId], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now()) @map("created_at")

  @@unique([executionId, clientSeq])
  @@index([executionId, offsetMs, clientSeq])
  @@map("scenario_execution_events")
}

model SpeechToTextModel {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  provider    SttProvider
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String      @map("created_by") @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  checks      SpeechToTextResult[]

  @@index([provider])
  @@index([createdById])
  @@map("speech_to_text_models")
}

model TextToSpeechModel {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  provider    TtsProvider
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String      @map("created_by") @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  clips       TextToSpeechClip[]

  @@index([provider])
  @@index([createdById])
  @@map("text_to_speech_models")
}

model LlmModel {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  provider    LlmProvider
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String      @map("created_by") @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([provider])
  @@index([createdById])
  @@map("llm_models")
}

model TextToSpeechClip {
  id              String            @id @default(uuid()) @db.Uuid
  modelId         String            @map("model_id") @db.Uuid
  model           TextToSpeechModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  cacheKey        String            @unique @map("cache_key")
  providerModelId String            @map("provider_model_id")
  voiceId         String            @map("voice_id")
  text            String
  audio           Bytes
  mimeType        String            @map("mime_type")
  byteSize        Int               @map("byte_size")
  priceUsd        Decimal?          @map("price_usd") @db.Decimal(12, 6)
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([modelId])
  @@map("text_to_speech_clips")
}

model DatasetSample {
  id          String   @id @default(uuid()) @db.Uuid
  sentence    String
  age         String?
  gender      String?
  locale      String?
  audio       Bytes
  audioSha256 String   @map("audio_sha256")
  mimeType    String   @map("mime_type")
  filename    String
  byteSize    Int      @map("byte_size")
  source      String?
  externalId  String?  @unique @map("external_id")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  speechToTextResults SpeechToTextResult[]

  @@index([createdById])
  @@index([source])
  @@index([audioSha256])
  @@map("dataset_samples")
}

model SpeechToTextResult {
  id            String             @id @default(uuid()) @db.Uuid
  engineKey     String             @map("engine_key")
  sampleId      String             @map("sample_id") @db.Uuid
  sample        DatasetSample      @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  status        SttCheckStatus
  transcript    String?
  languageCode  String?            @map("language_code")
  error         String?
  modelId       String?            @map("model_id") @db.Uuid
  model         SpeechToTextModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  attempts      Int                @default(1)
  createdAt     DateTime           @default(now()) @map("created_at")
  lastAttemptAt DateTime           @default(now()) @map("last_attempt_at")

  @@unique([engineKey, sampleId])
  @@index([sampleId])
  @@index([modelId, lastAttemptAt])
  @@map("speech_to_text_results")
}
