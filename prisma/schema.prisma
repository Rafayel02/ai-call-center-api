generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum SttProvider {
  ELEVENLABS
  HISPEECH
}

enum TtsProvider {
  ELEVENLABS
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  speechModels       SpeechToTextModel[]
  textToSpeechModels TextToSpeechModel[]
  datasetSamples DatasetSample[]
  organizations  Organization[]
  scenarios      Scenario[]

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  nameKey     String   @unique @map("name_key")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String     @map("created_by") @db.Uuid
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  scenarios   Scenario[]

  @@index([createdById])
  @@map("organizations")
}

model Scenario {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  icon           String
  graph          Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdById    String       @map("created_by") @db.Uuid
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([createdById])
  @@map("scenarios")
}

model SpeechToTextModel {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  provider    SttProvider
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String      @map("created_by") @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([provider])
  @@index([createdById])
  @@map("speech_to_text_models")
}

model TextToSpeechModel {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  provider    TtsProvider
  config      Json
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String      @map("created_by") @db.Uuid
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([provider])
  @@index([createdById])
  @@map("text_to_speech_models")
}

model DatasetSample {
  id          String   @id @default(uuid()) @db.Uuid
  sentence    String
  age         String?
  gender      String?
  locale      String?
  audio       Bytes
  mimeType    String   @map("mime_type")
  filename    String
  byteSize    Int      @map("byte_size")
  source      String?
  externalId  String?  @unique @map("external_id")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([source])
  @@map("dataset_samples")
}
